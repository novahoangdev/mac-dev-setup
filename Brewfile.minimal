# ==============================================================================
# Minimal Brewfile — Mac Dev & Vibe Coding Setup
# 
# INSTALLATION ORDER:
#   1. This file first (minimal baseline)
#   2. Then optionally: Brewfile.ai or Brewfile.apps
#   3. Or skip to Brewfile (full bundle)
#
# Run: brew bundle --file=Brewfile.minimal
# ==============================================================================

tap "homebrew/bundle"

# ============================================================
# PHASE 1: Essential Command-Line Workflow (9 tools)
# ============================================================
brew "starship"    # Cross-shell prompt with Git awareness
brew "eza"         # Modern ls replacement with color & Git status
brew "bat"         # Cat clone with syntax highlighting
brew "ripgrep"     # Faster grep written in Rust (rg)
brew "fzf"         # Fuzzy finder for shell history & file navigation
brew "zoxide"      # Smarter cd with frecency algorithm
brew "gh"          # GitHub CLI for PR/issue management
brew "tldr"        # Simplified man pages with examples
brew "jq"          # JSON processor for CLI pipelines
brew "yq"          # YAML/XML processor (jq for YAML)

# ============================================================
# PHASE 2: Reproducible Runtime Management
# ============================================================
brew "mise"        # Fast polyglot runtime manager (replaces asdf/nvm/pyenv)

# ============================================================
# PHASE 3: AI-First Editor & Terminal Baseline
# ============================================================
cask "cursor"      # VSCode fork with built-in AI pair programming
cask "ghostty"     # GPU-accelerated terminal written in Zig

# ==============================================================================
# Next Steps After Installation:
# ==============================================================================
# 1. Install pinned runtimes:
#      mise install && exec zsh
# 2. Configure Git identity:
#      git config --global user.name "Your Name"
#      git config --global user.email "you@example.com"
# 3. Authenticate GitHub CLI:
#      gh auth login
# 4. Verify installation:
#      bash scripts/verify-setup.en.sh --minimal
# ==============================================================================
